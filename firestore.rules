rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /teachers/{teacherId} {
      allow read: if signedIn() && request.auth.uid == teacherId;
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == studentId);
      allow create: if isTeacher();
      allow update: if isTeacher() || (signedIn() && request.auth.uid == studentId);
      allow delete: if isTeacher();

      match /{document=**} {
        allow read, write: if isTeacher() || (signedIn() && request.auth.uid == studentId);
      }
    }

    match /feedback/{messageId} {
      allow create: if signedIn()
                    && request.resource.data.studentId == request.auth.uid;
      allow read: if isTeacher()
                  || (signedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    match /studentAccess/{studentId} {
      allow read, create, update, delete: if isTeacher();
    }

    match /customExpressions/{expressionId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }
  }
}
